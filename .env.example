DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
# require for managed/cloud databases; set disable only on a private trusted network.
DATABASE_SSL=require
DATABASE_ALLOW_EXIT_ON_IDLE=false
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_ID=272723723
VIEW_HASH_SECRET=replace-with-a-second-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=article-media
# Supported today: supabase. Keep this name when migrating storage; add oss only
# after an OSS adapter has been implemented in lib/media-storage.js.
MEDIA_STORAGE_DRIVER=supabase
RESEND_API_KEY=
